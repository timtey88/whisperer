{
    // General
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "never"
    },
    "files.eol": "\n",
    // Rust analyzer
    "rust-analyzer.checkOnSave": false,
    // "rust-analyzer.check.command": "clippy",
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer"
    },
    // Formatting
    "prettier.configPath": ".prettierrc.json",
    // i18n
    "i18n-ally.enabledParsers": [
        "ts",
        "json"
    ],
    "i18n-ally.sortKeys": true,
    "i18n-ally.namespace": true,
    "i18n-ally.sourceLanguage": "en-US",
    "i18n-ally.enabledFrameworks": [
        "react",
        "svelte"
    ],
    "i18n-ally.keystyle": "flat",
    "i18n-ally.translate.engines": [
        "google",
    ],
    "i18n-ally.localesPaths": [
        "desktop/src-tauri/locales"
    ],
    "i18n-ally.pathMatcher": "{locale}/{namespace}.json",
    "i18n-ally.tabStyle": "tab",
    "workbench.colorCustomizations": {
        "statusBar.background": "#12bcf0",
        "statusBarItem.hoverBackground": "#0c98c3",
        "statusBarItem.remoteBackground": "#12bcf0",
        "statusBar.foreground": "#15202b",
        "statusBarItem.remoteForeground": "#15202b",
        "activityBar.activeBackground": "#42caf3",
        "activityBar.background": "#42caf3",
        "activityBar.foreground": "#15202b",
        "activityBar.inactiveForeground": "#15202b99",
        "activityBarBadge.background": "#d20da4",
        "activityBarBadge.foreground": "#e7e7e7",
        "sash.hoverBorder": "#42caf3",
        "statusBar.border": "#12bcf0",
        "sideBar.border": "#42caf3",
        "panel.border": "#42caf3",
        "commandCenter.border": "#15202b99",
        "titleBar.activeBackground": "#12bcf0",
        "titleBar.activeForeground": "#15202b",
        "titleBar.border": "#12bcf0",
        "titleBar.inactiveBackground": "#12bcf099",
        "titleBar.inactiveForeground": "#15202b99",
        "tab.activeBorder": "#42caf3"
    },
    "peacock.color": "#12bcf0",
}