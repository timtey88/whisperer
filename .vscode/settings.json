{
    // General
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "never"
    },
    "files.eol": "\n",
    // Rust analyzer
    "rust-analyzer.checkOnSave": false,
    // "rust-analyzer.check.command": "clippy",
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer"
    },
    // Formatting
    "prettier.configPath": ".prettierrc.json",
    // i18n
    "i18n-ally.enabledParsers": [
        "ts",
        "json"
    ],
    "i18n-ally.sortKeys": true,
    "i18n-ally.namespace": true,
    "i18n-ally.sourceLanguage": "en-US",
    "i18n-ally.enabledFrameworks": [
        "react",
        "svelte"
    ],
    "i18n-ally.keystyle": "flat",
    "i18n-ally.translate.engines": [
        "google",
    ],
    "i18n-ally.localesPaths": [
        "desktop/src-tauri/locales"
    ],
    "i18n-ally.pathMatcher": "{locale}/{namespace}.json",
    "i18n-ally.tabStyle": "tab",
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#7d5154",
        "activityBar.background": "#7d5154",
        "activityBarBadge.background": "#689b64",
        "activityBarBadge.foreground": "#15202b",
        "editorGroup.border": "#7d5154",
        "panel.border": "#7d5154",
        "sash.hoverBorder": "#7d5154",
        "sideBar.border": "#7d5154",
        "statusBar.background": "#5e3d3f",
        "statusBar.border": "#5e3d3f",
        "statusBar.debuggingBackground": "#3d5e5c",
        "statusBar.debuggingBorder": "#3d5e5c",
        "statusBarItem.hoverBackground": "#7d5154",
        "statusBarItem.remoteBackground": "#5e3d3f",
        "tab.activeBorder": "#7d5154",
        "titleBar.activeBackground": "#5e3d3f",
        "titleBar.border": "#5e3d3f",
        "titleBar.inactiveBackground": "#5e3d3f99"
    },
    "peacock.color": "#5e3d3f",
}